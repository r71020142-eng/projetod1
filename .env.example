# ==============================================================================
# DEMOSTRATIVO MTD - Variáveis de Ambiente e Configuração
# ==============================================================================
# Este arquivo serve de modelo para configuração local (.env.local) e de produção.
# NÃO insira chaves reais, senhas de produção ou segredos neste arquivo versionado.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Modo de Execução da Aplicação (Etapa 10.2A - Server-Only)
# ------------------------------------------------------------------------------
# APP_MODE aceita exclusivamente: 'demo' ou 'production' (padrão: demo).
APP_MODE=demo

# AUTH_MODE aceita: 'demo' ou 'supabase' (padrão: demo).
# Em 'demo', a autenticação real é dispensada e a navegação demonstrativa é aberta.
# Em 'supabase', a autenticação real via Supabase Auth e cookies SSR é obrigatória.
AUTH_MODE=demo

# DATA_SOURCE aceita: 'local' ou 'supabase' (padrão: local).
# Em 'local', os repositórios utilizam localStorage e dados semente.
# Em 'supabase', os repositórios conectam ao banco de dados PostgreSQL do Supabase.
DATA_SOURCE=local

# CORE_USERS_DATA_SOURCE aceita: 'local' ou 'supabase' (Etapa 10.2B2).
CORE_USERS_DATA_SOURCE=local
NEXT_PUBLIC_CORE_USERS_DATA_SOURCE=local

# Fontes granulares acadêmicas (Etapas 10.3A a 10.4E)
ACADEMIC_CORE_DATA_SOURCE=local
NEXT_PUBLIC_ACADEMIC_CORE_DATA_SOURCE=local

ACADEMIC_AGENDA_DATA_SOURCE=local
NEXT_PUBLIC_ACADEMIC_AGENDA_DATA_SOURCE=local

ACADEMIC_CONTENT_DATA_SOURCE=local
NEXT_PUBLIC_ACADEMIC_CONTENT_DATA_SOURCE=local

ACADEMIC_EVALUATIONS_DATA_SOURCE=local
NEXT_PUBLIC_ACADEMIC_EVALUATIONS_DATA_SOURCE=local

ACADEMIC_FLASHCARDS_DATA_SOURCE=local
NEXT_PUBLIC_ACADEMIC_FLASHCARDS_DATA_SOURCE=local

ACADEMIC_SELF_PRESENTATION_DATA_SOURCE=local
NEXT_PUBLIC_ACADEMIC_SELF_PRESENTATION_DATA_SOURCE=local

COMMUNITY_DATA_SOURCE=local
NEXT_PUBLIC_COMMUNITY_DATA_SOURCE=local

GAMIFICATION_DATA_SOURCE=local
NEXT_PUBLIC_GAMIFICATION_DATA_SOURCE=local

# Flag de apresentação do modo demonstrativo no cliente
NEXT_PUBLIC_DEMO_MODE=true

# Fuso horário padrão do sistema para agendamento pedagógico
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Sao_Paulo

# URL base da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase - Banco de Dados, Autenticação e RLS (Etapa 10.1)
# ------------------------------------------------------------------------------
# URL pública do projeto Supabase (acessível pelo navegador e servidor)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública/publishable do Supabase (segura para o navegador com RLS ativo)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable-aqui

# Chave privada/secret do Supabase (STRICTLY SERVER-ONLY - NUNCA expor no cliente)
# Utilizada exclusivamente por tarefas e rotas administrativas server-side
SUPABASE_SECRET_KEY=sua-chave-secret-aqui

# ------------------------------------------------------------------------------
# 3. Banco de Dados Relacional Direto (Opcional - Migrações CLI / Pooler)
# ------------------------------------------------------------------------------
# String de conexão com pooler (Porta 6543)
DATABASE_URL=

# Conexão direta para migrações DDL (Porta 5432)
DATABASE_DIRECT_URL=

# ------------------------------------------------------------------------------
# 4. Armazenamento de Arquivos e Mídia (Upload Seguro em Nuvem - Etapa 10.4)
# ------------------------------------------------------------------------------
STORAGE_BUCKET_NAME=mtd-materiais-midia
STORAGE_PUBLIC_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# 5. Integrações Externas Futuras
# ------------------------------------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
AI_API_KEY=
WHATSAPP_API_TOKEN=
