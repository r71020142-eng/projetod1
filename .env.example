# ==============================================================================
# DEMOSTRATIVO MTD - Variáveis de Ambiente e Configuração
# ==============================================================================
# Este arquivo serve de modelo para configuração local (.env.local) e de produção.
# NÃO insira chaves reais, senhas de produção ou segredos neste arquivo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações da Aplicação e Modo Demonstrativo (Etapa 9)
# ------------------------------------------------------------------------------
# Ativa (true) ou desativa (false) o ambiente demonstrativo com dados semente (localStorage).
# Em false, o seletor de papéis é desativado e o acesso exige autenticação real no backend.
NEXT_PUBLIC_DEMO_MODE=true

# Fuso horário padrão do sistema para exibição e agendamento pedagógico
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Sao_Paulo

# URL base da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Banco de Dados Relacional (PostgreSQL - Migração Futura)
# ------------------------------------------------------------------------------
# String de conexão com pool de conexões (ex: Prisma, Supabase Pooler, PgBouncer)
DATABASE_URL=

# Conexão direta com o banco para execução de migrações DDL
DATABASE_DIRECT_URL=

# ------------------------------------------------------------------------------
# 3. Autenticação e Autorização (RBAC)
# ------------------------------------------------------------------------------
# Segredo para assinatura de tokens JWT e sessões
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Se utilizar Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. Armazenamento de Arquivos e Mídia (Upload Seguro em Nuvem)
# ------------------------------------------------------------------------------
# Bucket S3 compatível / Cloud Storage para gravações de Self Presentation e PDFs
STORAGE_BUCKET_NAME=
STORAGE_PUBLIC_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=

# ------------------------------------------------------------------------------
# 5. Integrações Externas Futuras (Planejamento Arquitetural)
# ------------------------------------------------------------------------------
# Integração oficial Server-to-Server com API do Zoom (aulas e reuniões)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Provedor de Transcrição e Inteligência Artificial (áudio/vídeo)
AI_API_KEY=

# Gateway de Comunicação WhatsApp / Notificações Transacionais
WHATSAPP_API_TOKEN=
